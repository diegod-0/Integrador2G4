# =============================================================================
# RESCUELINK - VARIABLES DE ENTORNO PARA DOCKER COMPOSE (RAÍZ)
# Copiar este archivo a '.env' antes de ejecutar: docker compose up -d
# =============================================================================

# Puerto de PostgreSQL expuesto en la máquina anfitriona (Host)
POSTGRES_PORT=5434

# Credenciales de la base de datos PostgreSQL + PostGIS
POSTGRES_DB=rescuelink_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
