# =============================================================================
# RESCUELINK BACKEND - VARIABLES DE ENTORNO LOCALES
# Copiar este archivo a '.env' para desarrollo local (nunca subir .env a git)
# =============================================================================

SERVER_PORT=8080

# Base de datos PostgreSQL con extensión PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescuelink_db
DB_USER=postgres
DB_PASSWORD=postgres

# Secreto criptográfico HMAC-SHA256 para firma de tokens JWT (256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Orígenes permitidos para peticiones CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
